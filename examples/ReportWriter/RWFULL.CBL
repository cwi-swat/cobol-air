000000 IDENTIFICATION DIVISION.
000000 PROGRAM-ID. RWFULL.
000000*    USES THE REPORT WRITER CLAUSES AND STATEMENTS OF COBOL-85
000000*    THAT THE NIST TEST SET DOES NOT USE.
000000 ENVIRONMENT DIVISION.
000000 INPUT-OUTPUT SECTION.
000000 FILE-CONTROL.
000000     SELECT SALES-FILE ASSIGN TO "SALES.DAT".
000000     SELECT PRINT-FILE ASSIGN TO "SALES.LST".
000000 DATA DIVISION.
000000 FILE SECTION.
000000 FD  SALES-FILE.
000000 01  SALES-REC.
000000     03 SR-REGION         PIC X(10).
000000     03 SR-BRANCH         PIC X(10).
000000     03 SR-AMOUNT         PIC 9(5)V99.
000000 FD  PRINT-FILE
000000     REPORTS ARE SALES-REPORT SUMMARY-REPORT.
000000 WORKING-STORAGE SECTION.
000000 01  WS-EOF               PIC X VALUE "N".
000000 REPORT SECTION.
000000 RD  SALES-REPORT IS GLOBAL
000000     CODE "S"
000000     CONTROLS ARE FINAL SR-REGION SR-BRANCH
000000     PAGE LIMITS ARE 60 LINES
000000     HEADING 1
000000     FIRST DETAIL 5
000000     LAST DETAIL 50
000000     FOOTING 55.
000000 01  TYPE IS REPORT HEADING NEXT GROUP NEXT PAGE.
000000     03 LINE 1 COLUMN 30 PIC X(12) VALUE "SALES REPORT".
000000 01  PAGE-HEAD TYPE PH LINE NUMBER IS 1.
000000     03 COLUMN 1 PIC X(6) VALUE "REGION".
000000     03 COLUMN 70 PIC X(5) VALUE "PAGE ".
000000     03 COLUMN 75 PIC ZZ9 SOURCE PAGE-COUNTER OF SALES-REPORT.
000000 01  REGION-HEAD TYPE CH SR-REGION LINE PLUS 2.
000000     03 COLUMN 1 PIC X(10) SOURCE SR-REGION.
000000 01  DETAIL-LINE TYPE DETAIL LINE PLUS 1 USAGE DISPLAY.
000000     03 COLUMN 1 PIC X(10) SOURCE SR-REGION GROUP INDICATE.
000000     03 COLUMN 15 PIC X(10) SOURCE SR-BRANCH.
000000     03 DL-AMOUNT COLUMN 30 PIC ZZ,ZZ9.99 SOURCE SR-AMOUNT
000000        BLANK WHEN ZERO.
000000     03 COLUMN 45 PIC S9(5) SIGN IS LEADING SEPARATE CHARACTER
000000        SOURCE SR-AMOUNT.
000000     03 COLUMN 55 PIC X(10) JUSTIFIED RIGHT VALUE IS "OK".
000000 01  BRANCH-FOOT TYPE IS CONTROL FOOTING SR-BRANCH
000000     LINE PLUS 1 NEXT GROUP PLUS 1.
000000     03 BRANCH-TOTAL COLUMN 30 PIC ZZZ,ZZ9.99
000000        SUM SR-AMOUNT UPON DETAIL-LINE.
000000 01  REGION-FOOT TYPE CF SR-REGION LINE PLUS 2.
000000     03 REGION-TOTAL COLUMN 30 PIC ZZZ,ZZ9.99
000000        SUM BRANCH-TOTAL RESET ON FINAL.
000000 01  TYPE CONTROL FOOTING FINAL LINE 52 ON NEXT PAGE.
000000     03 COLUMN 30 PIC Z,ZZZ,ZZ9.99 SUM REGION-TOTAL.
000000 01  TYPE PAGE FOOTING LINE 58.
000000     03 COLUMN 1 PIC 99 SOURCE LINE-COUNTER.
000000 01  TYPE IS RF LINE NUMBER 59.
000000     03 COLUMN 1 PIC X(13) VALUE "END OF REPORT".
000000 RD  SUMMARY-REPORT
000000     CONTROL IS SR-REGION
000000     PAGE 60.
000000 01  SUMMARY-LINE TYPE DE.
000000     03 LINE PLUS 1.
000000        05 COLUMN 1 PIC X(10) SOURCE SR-REGION.
000000        05 COLUMN 15 PIC ZZZ,ZZ9.99 SUM SR-AMOUNT SUM SR-AMOUNT.
000000 01  TYPE RH.
000000 01  TYPE PF.
000000 01  TYPE CH FINAL.
000000 PROCEDURE DIVISION.
000000 DECLARATIVES.
000000 BEFORE-DETAIL SECTION.
000000     USE BEFORE REPORTING DETAIL-LINE.
000000 CHECK-DETAIL.
000000     IF SR-AMOUNT = ZERO
000000         SUPPRESS PRINTING
000000     END-IF.
000000 BEFORE-FINAL SECTION.
000000     USE GLOBAL BEFORE REPORTING REGION-FOOT.
000000 CHECK-FINAL.
000000     SUPPRESS.
000000 END DECLARATIVES.
000000 MAIN SECTION.
000000 START-UP.
000000     OPEN INPUT SALES-FILE OUTPUT PRINT-FILE.
000000     INITIATE SALES-REPORT SUMMARY-REPORT.
000000     PERFORM UNTIL WS-EOF = "Y"
000000         READ SALES-FILE
000000             AT END MOVE "Y" TO WS-EOF
000000             NOT AT END GENERATE DETAIL-LINE
000000                        GENERATE SUMMARY-REPORT
000000         END-READ
000000     END-PERFORM.
000000     IF LINE-COUNTER OF SALES-REPORT > 40
000000         DISPLAY PAGE-COUNTER IN SALES-REPORT
000000     END-IF.
000000     TERMINATE SALES-REPORT SUMMARY-REPORT.
000000     CLOSE SALES-FILE PRINT-FILE.
000000     STOP RUN.
