A GREATER THEN B
}

syntax test expression12 (Expression) expects ok {
A > B AND LESS C
}

syntax test expression13 (Expression) expects ok {
X EQUAL TO ZEROS AND GREATERZERO
}

syntax test expression14 (Expression) expects ok {
-5 - -5 * - A
}

syntax test fileAndSortDescriptionEntryClause1 (FileAndSortDescriptionEntryClause) expects ok {
LINAGE IS 60 LINES WITH FOOTING AT 55 LINES AT TOP 5 LINES AT BOTTOM 2
}

syntax test fileAndSortDescriptionEntryClause2 (FileAndSortDescriptionEntryClause) expects ok {
LINAGE 60 LINES TOP 5
}

syntax test copyStatement1 (CopyStatement) expects ok {
COPY KSM31 REPLACING ==PERFORM== BY MOVE ZERO BY SPACE.
}

syntax test statement15 (Statement) expects ok {
SEARCH ALL T WHEN K1 (I) = A AND K2 (I) = B AND C MOVE 1 TO X END-SEARCH
}

syntax test statement16 (Statement) expects ok {
       UNSTRING ID1-XN-12
             DELIMITED BY "E" OR "H" OR "K" OR "L"
             INTO ID4C-XXX ID4B-XX ID4A-X
             TALLYING IN ID11-DU-2V0
}

syntax test statement17 (Statement) expects ok {
       INSPECT WRK-XN-83-1
         REPLACING LEADING "AH" BY "OH" BEFORE INITIAL " AH YES"
                   FIRST "I" BY "O" AFTER INITIAL "."
                   ALL ". " BY ", " AFTER INITIAL "HE"
}

syntax test sentence6 (Sentence) expects ok {
       DISPLAY  ALL "ABCD"
*        NOTE "ALL" LITERAL.
     MOVE     "ABCD" TO DIS-PLAYER.
}

