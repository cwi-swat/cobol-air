      "ZEROS" -> Figurative-constant-simple {cons("Figurative-constant-simple-c2")}
      "ZEROES" -> Figurative-constant-simple {cons("Figurative-constant-simple-c3")}
      "SPACE" -> Figurative-constant-simple {cons("Figurative-constant-simple-c4")}
      "SPACES" -> Figurative-constant-simple {cons("Figurative-constant-simple-c5")}
