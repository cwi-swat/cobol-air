definition

module Main
  imports VSC-dd-entry VSC-conf-sec VSC-fd-entry VSC-io-sec VSC-id-div VSC-env-div VSC-data-div VSC-main VSC-proc-div VSC-lex VSC-cond VSC-expr VSC-stat

module VSC-dd-entry
  imports VSC-lex VSC-expr VSC-conf-sec
  exports
    sorts
      Alt-data-name-filler
      Alt-leading-trailing
      Alt-left-right
      Blank-when-zero-clause
      Condition-value-clause
      Data-description-entry
      Data-description-entry-1
      Data-description-entry-clause
      Data-description-entry-clauses
      External-clause
      Global-clause
      Indexed-by
      Integer-to
      Justified
      Justified-clause
      Occurs-clause
      Occurs-clause-1
      Occurs-clause-2
      Occurs-clause-key
      Picture
      Picture-clause
      Redefines-clause
      Renames-clause
      Separate-character
      Sign-clause
      Sign-is
      Synchronized
      Synchronized-clause
      Usage
      Usage-clause
      Usage-is
      Values-are
      Zeroes

    context-free syntax
      Data-name -> Alt-data-name-filler {cons("Alt-data-name-filler-c1")}
      "FILLER" -> Alt-data-name-filler {cons("Alt-data-name-filler-c2")}

      "LEADING" -> Alt-leading-trailing {cons("Alt-leading-trailing-c1")}
      "TRAILING" -> Alt-leading-trailing {cons("Alt-leading-trailing-c2")}

      "LEFT" -> Alt-left-right {cons("Alt-left-right-c1")}
      "RIGHT" -> Alt-left-right {cons("Alt-left-right-c2")}

      "BLANK" "WHEN"? Zeroes -> Blank-when-zero-clause {cons("Blank-when-zero-clause")}

      Values-are Literal-through-literal+ -> Condition-value-clause {cons("Condition-value-clause")}

      Data-description-entry-1 -> Data-description-entry {cons("Data-description-entry-c1")}
      Copy-statement -> Data-description-entry {cons("Data-description-entry-c2")}

      Level-number Alt-data-name-filler? Data-description-entry-clauses "."? -> Data-description-entry-1 {cons("Data-description-entry-1")}

      Picture-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c1")}
      Redefines-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c2")}
      Blank-when-zero-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c3")}
      External-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c4")}
      Global-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c5")}
      Justified-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c6")}
      Occurs-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c7")}
      Sign-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c8")}
      Synchronized-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c9")}
      Usage-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c10")}
      Renames-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c11")}
      Condition-value-clause -> Data-description-entry-clause {cons("Data-description-entry-clause-c12")}

      Data-description-entry-clause* -> Data-description-entry-clauses {cons("Data-description-entry-clauses")}

      "IS"? "EXTERNAL" -> External-clause {cons("External-clause")}

      "IS"? "GLOBAL" -> Global-clause {cons("Global-clause")}

      "INDEXED" "BY"? Index-name+ -> Indexed-by {cons("Indexed-by")}

      Integer "TO" -> Integer-to {cons("Integer-to")}

      "JUSTIFIED" -> Justified {cons("Justified-c1")}
      "JUST" -> Justified {cons("Justified-c2")}

      Justified "RIGHT"? -> Justified-clause {cons("Justified-clause")}

      Occurs-clause-2 -> Occurs-clause {cons("Occurs-clause-c1")}
      Occurs-clause-1 -> Occurs-clause {cons("Occurs-clause-c2")}

      "OCCURS" Integer "TIMES"? Occurs-clause-key* Indexed-by? -> Occurs-clause-1 {cons("Occurs-clause-1")}

      "OCCURS" Integer-to? Integer "TIMES"? "DEPENDING" "ON"? Qualified-data-name Occurs-clause-key* Indexed-by? -> Occurs-clause-2 {cons("Occurs-clause-2")}

      Alt-ascending-descending "KEY"? "IS"? Qualified-data-name+ -> Occurs-clause-key {cons("Occurs-clause-key")}

      "PICTURE" -> Picture {cons("Picture-c1")}
      "PIC" -> Picture {cons("Picture-c2")}

      Picture "IS"? Picture-string -> Picture-clause {cons("Picture-clause")}

      "REDEFINES" Data-name -> Redefines-clause {cons("Redefines-clause")}

      "RENAMES" Qualified-data-name Through-qualified-data-name? -> Renames-clause {cons("Renames-clause")}

      "SEPARATE" "CHARACTER"? -> Separate-character {cons("Separate-character")}

      Sign-is? Alt-leading-trailing Separate-character? -> Sign-clause {cons("Sign-clause")}

      "SIGN" "IS"? -> Sign-is {cons("Sign-is")}

      "SYNCHRONIZED" -> Synchronized {cons("Synchronized-c1")}
      "SYNC" -> Synchronized {cons("Synchronized-c2")}

      Synchronized Alt-left-right? -> Synchronized-clause {cons("Synchronized-clause")}

      "BINARY" -> Usage {cons("Usage-c1")}
      "COMP" -> Usage {cons("Usage-c2")}
      "COMP-1" -> Usage {cons("Usage-c3")}
      "COMP-2" -> Usage {cons("Usage-c4")}
      "COMP-3" -> Usage {cons("Usage-c5")}
      "COMP-4" -> Usage {cons("Usage-c6")}
      "COMPUTATIONAL" -> Usage {cons("Usage-c7")}
      "COMPUTATIONAL-1" -> Usage {cons("Usage-c8")}
      "COMPUTATIONAL-2" -> Usage {cons("Usage-c9")}
      "COMPUTATIONAL-3" -> Usage {cons("Usage-c10")}
      "COMPUTATIONAL-4" -> Usage {cons("Usage-c11")}
      "DISPLAY" -> Usage {cons("Usage-c12")}
      "DISPLAY-1" -> Usage {cons("Usage-c13")}
      "INDEX" -> Usage {cons("Usage-c14")}
      "PACKED-DECIMAL" -> Usage {cons("Usage-c15")}
      "POINTER" -> Usage {cons("Usage-c16")}

      Usage-is? Usage -> Usage-clause {cons("Usage-clause")}

      "USAGE" "IS"? -> Usage-is {cons("Usage-is")}

      Values Are? -> Values-are {cons("Values-are")}

      "ZERO" -> Zeroes {cons("Zeroes-c1")}
      "ZEROS" -> Zeroes {cons("Zeroes-c2")}
      "ZEROES" -> Zeroes {cons("Zeroes-c3")}


module VSC-conf-sec
  imports VSC-cond VSC-expr
  exports
    sorts
      Alphabet-clause
      Alphabet-type
      Alphabet-type-also
      Alphabet-type-also-through
      Alphabet-type-alsos
      Alphabet-type-other
      Alphabet-type-others
      Are
      Class-clause
      Configuration-section
      Configuration-section-paragraph
      Configuration-section-paragraphs
      Currency-sign-clause
      Decimal-point-clause
      In-alphabet-name
      Is-mnemonic-name
      Memory-size
      Memory-size-type
      Object-computer-name
      Object-computer-paragraph
      Object-computer-paragraph-sequence-phrase
      Off-status
      On-status
      Program-collating-sequence
      Segment-limit
      Source-computer-name
      Source-computer-paragraph
      Special-names-paragraph
      Special-names-paragraph-clause
      Special-names-paragraph-clauses
      Special-names-paragraph-phrase
      Special-names-paragraph-phrase-tail
      Special-names-paragraph-status-phrase
      Special-names-paragraph-status-phrase-1
      Special-names-paragraph-status-phrase-2
      Symbolic-character-mapping
      Symbolic-characters-clause
      With-debugging-mode

    context-free syntax
      "ALPHABET" Alphabet-name "IS"? Alphabet-type -> Alphabet-clause {cons("Alphabet-clause")}

      "STANDARD-1" -> Alphabet-type {cons("Alphabet-type-c1")}
      "STANDARD-2" -> Alphabet-type {cons("Alphabet-type-c2")}
      "NATIVE" -> Alphabet-type {cons("Alphabet-type-c3")}
      "EBCDIC" -> Alphabet-type {cons("Alphabet-type-c4")}
      Alphabet-type-others -> Alphabet-type {cons("Alphabet-type-c5")}

      "ALSO" Literal -> Alphabet-type-also {cons("Alphabet-type-also")}

      Through-literal -> Alphabet-type-also-through {cons("Alphabet-type-also-through-c1")}
      Alphabet-type-alsos -> Alphabet-type-also-through {cons("Alphabet-type-also-through-c2")}

      Alphabet-type-also+ -> Alphabet-type-alsos {cons("Alphabet-type-alsos")}

      Literal Alphabet-type-also-through? -> Alphabet-type-other {cons("Alphabet-type-other")}

      Alphabet-type-other+ -> Alphabet-type-others {cons("Alphabet-type-others")}

      "ARE" -> Are {cons("Are-c1")}
      "IS" -> Are {cons("Are-c2")}

      "CLASS" Class-name "IS"? Literal-through-literal+ -> Class-clause {cons("Class-clause")}

      "CONFIGURATION" "SECTION" "." Configuration-section-paragraphs -> Configuration-section {cons("Configuration-section")}

      Source-computer-paragraph -> Configuration-section-paragraph {cons("Configuration-section-paragraph-c1")}
      Object-computer-paragraph -> Configuration-section-paragraph {cons("Configuration-section-paragraph-c2")}
      Special-names-paragraph -> Configuration-section-paragraph {cons("Configuration-section-paragraph-c3")}

      Configuration-section-paragraph* -> Configuration-section-paragraphs {cons("Configuration-section-paragraphs")}

      "CURRENCY" "SIGN"? "IS"? Literal -> Currency-sign-clause {cons("Currency-sign-clause")}

      "DECIMAL-POINT" "IS"? "COMMA" -> Decimal-point-clause {cons("Decimal-point-clause")}

      "IN" Alphabet-name -> In-alphabet-name {cons("In-alphabet-name")}

      "IS"? Mnemonic-name Special-names-paragraph-status-phrase? -> Is-mnemonic-name {cons("Is-mnemonic-name")}

      "MEMORY" "SIZE"? Integer Memory-size-type -> Memory-size {cons("Memory-size")}

      "WORDS" -> Memory-size-type {cons("Memory-size-type-c1")}
      "CHARACTERS" -> Memory-size-type {cons("Memory-size-type-c2")}
      "MODULES" -> Memory-size-type {cons("Memory-size-type-c3")}

      Computer-name Memory-size? Object-computer-paragraph-sequence-phrase "." -> Object-computer-name {cons("Object-computer-name")}

      "OBJECT-COMPUTER" "." Object-computer-name? -> Object-computer-paragraph {cons("Object-computer-paragraph")}

      Program-collating-sequence? Segment-limit? -> Object-computer-paragraph-sequence-phrase {cons("Object-computer-paragraph-sequence-phrase")}

      "OFF" "STATUS"? "IS"? Condition -> Off-status {cons("Off-status")}

      "ON" "STATUS"? "IS"? Condition -> On-status {cons("On-status")}

      "PROGRAM"? "COLLATING"? "SEQUENCE" "IS"? Alphabet-name -> Program-collating-sequence {cons("Program-collating-sequence")}

      "SEGMENT-LIMIT" "IS"? Priority-number -> Segment-limit {cons("Segment-limit")}

      Computer-name With-debugging-mode? "." -> Source-computer-name {cons("Source-computer-name")}

      "SOURCE-COMPUTER" "." Source-computer-name? -> Source-computer-paragraph {cons("Source-computer-paragraph")}

      "SPECIAL-NAMES" "." Special-names-paragraph-phrase* Special-names-paragraph-clauses "."? -> Special-names-paragraph {cons("Special-names-paragraph")}

      Alphabet-clause -> Special-names-paragraph-clause {cons("Special-names-paragraph-clause-c1")}
      Symbolic-characters-clause -> Special-names-paragraph-clause {cons("Special-names-paragraph-clause-c2")}
      Class-clause -> Special-names-paragraph-clause {cons("Special-names-paragraph-clause-c3")}
      Currency-sign-clause -> Special-names-paragraph-clause {cons("Special-names-paragraph-clause-c4")}
      Decimal-point-clause -> Special-names-paragraph-clause {cons("Special-names-paragraph-clause-c5")}

      Special-names-paragraph-clause* -> Special-names-paragraph-clauses {cons("Special-names-paragraph-clauses")}

      Environment-name Special-names-paragraph-phrase-tail -> Special-names-paragraph-phrase {cons("Special-names-paragraph-phrase")}

      Is-mnemonic-name -> Special-names-paragraph-phrase-tail {cons("Special-names-paragraph-phrase-tail-c1")}
      Special-names-paragraph-status-phrase -> Special-names-paragraph-phrase-tail {cons("Special-names-paragraph-phrase-tail-c2")}

      Special-names-paragraph-status-phrase-1 -> Special-names-paragraph-status-phrase {cons("Special-names-paragraph-status-phrase-c1")}
      Special-names-paragraph-status-phrase-2 -> Special-names-paragraph-status-phrase {cons("Special-names-paragraph-status-phrase-c2")}

      "ON" "STATUS"? "IS"? Condition Off-status? -> Special-names-paragraph-status-phrase-1 {cons("Special-names-paragraph-status-phrase-1")}

      "OFF" "STATUS"? "IS"? Condition On-status? -> Special-names-paragraph-status-phrase-2 {cons("Special-names-paragraph-status-phrase-2")}

      Symbolic-character+ Are? Integer+ -> Symbolic-character-mapping {cons("Symbolic-character-mapping")}

      "SYMBOLIC" "CHARACTERS"? Symbolic-character-mapping+ In-alphabet-name? -> Symbolic-characters-clause {cons("Symbolic-characters-clause")}

      "WITH"? "DEBUGGING" "MODE" -> With-debugging-mode {cons("With-debugging-mode")}


module VSC-fd-entry
  imports VSC-dd-entry VSC-lex VSC-conf-sec VSC-expr
  exports
    sorts
      Alt-characters-records
      Alt-data-name-integer
      Alt-fd-sd
      Alt-qualified-data-name-literal
      Block-contains-clause
      Code-set-clause
      Data-names
      Data-records-clause
      Depending-on
      File-and-sort-description-entry
      File-and-sort-description-entry-clause
      File-and-sort-description-entry-clauses
      Footing
      From-integer
      Label-records-clause
      Label-records-clause-tail
      Linage-clause
      Linage-footing-phrase
      Lines-bottom
      Lines-top
      Record-clause
      Record-clause-tail
      Record-clause-tail-1
      Record-clause-tail-2
      Record-clause-tail-3
      Record-varying-phrase
      Recording-mode-clause
      Records-are
      To-integer
      Value-of-clause
      Value-of-clause-tail

    context-free syntax
      "CHARACTERS" -> Alt-characters-records {cons("Alt-characters-records-c1")}
      "RECORDS" -> Alt-characters-records {cons("Alt-characters-records-c2")}
      "RECORD" -> Alt-characters-records {cons("Alt-characters-records-c3")}

      Data-name -> Alt-data-name-integer {cons("Alt-data-name-integer-c1")}
      Integer -> Alt-data-name-integer {cons("Alt-data-name-integer-c2")}

      "FD" -> Alt-fd-sd {cons("Alt-fd-sd-c1")}
      "SD" -> Alt-fd-sd {cons("Alt-fd-sd-c2")}

      Qualified-data-name -> Alt-qualified-data-name-literal {cons("Alt-qualified-data-name-literal-c1")}
      Literal -> Alt-qualified-data-name-literal {cons("Alt-qualified-data-name-literal-c2")}

      "BLOCK" "CONTAINS"? Integer-to? Integer Alt-characters-records? -> Block-contains-clause {cons("Block-contains-clause")}

      "CODE-SET" "IS"? Alphabet-name -> Code-set-clause {cons("Code-set-clause")}

      Data-name+ -> Data-names {cons("Data-names")}

      "DATA" Records-are Data-name+ -> Data-records-clause {cons("Data-records-clause")}

      "DEPENDING" "ON"? Data-name -> Depending-on {cons("Depending-on")}

      Alt-fd-sd File-name File-and-sort-description-entry-clauses "." -> File-and-sort-description-entry {cons("File-and-sort-description-entry")}

      External-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c1")}
      Global-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c2")}
      Block-contains-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c3")}
      Record-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c4")}
      Label-records-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c5")}
      Value-of-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c6")}
      Data-records-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c7")}
      Linage-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c8")}
      Recording-mode-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c9")}
      Code-set-clause -> File-and-sort-description-entry-clause {cons("File-and-sort-description-entry-clause-c10")}

      File-and-sort-description-entry-clause* -> File-and-sort-description-entry-clauses {cons("File-and-sort-description-entry-clauses")}

      "WITH"? "FOOTING" "AT"? Alt-data-name-integer -> Footing {cons("Footing")}

      "FROM"? Integer -> From-integer {cons("From-integer")}

      "LABEL" Records-are Label-records-clause-tail -> Label-records-clause {cons("Label-records-clause")}

      "STANDARD" -> Label-records-clause-tail {cons("Label-records-clause-tail-c1")}
      "OMITTED" -> Label-records-clause-tail {cons("Label-records-clause-tail-c2")}
      Data-names -> Label-records-clause-tail {cons("Label-records-clause-tail-c3")}

      "LINAGE" "IS"? Alt-data-name-integer "LINES"? Linage-footing-phrase -> Linage-clause {cons("Linage-clause")}

      Footing? Lines-top? Lines-bottom? -> Linage-footing-phrase {cons("Linage-footing-phrase")}

      "LINES"? "AT"? "BOTTOM" Alt-data-name-integer -> Lines-bottom {cons("Lines-bottom")}

      "LINES"? "AT"? "TOP" Alt-data-name-integer -> Lines-top {cons("Lines-top")}

      "RECORD" Record-clause-tail -> Record-clause {cons("Record-clause")}

      Record-clause-tail-2 -> Record-clause-tail {cons("Record-clause-tail-c1")}
      Record-clause-tail-1 -> Record-clause-tail {cons("Record-clause-tail-c2")}
      Record-clause-tail-3 -> Record-clause-tail {cons("Record-clause-tail-c3")}

      "CONTAINS"? Integer "CHARACTERS"? -> Record-clause-tail-1 {cons("Record-clause-tail-1")}

      "CONTAINS"? Integer "TO" Integer "CHARACTERS"? -> Record-clause-tail-2 {cons("Record-clause-tail-2")}

      Record-varying-phrase Depending-on? -> Record-clause-tail-3 {cons("Record-clause-tail-3")}

      "IS"? "VARYING" "IN"? "SIZE"? From-integer? To-integer? "CHARACTERS"? -> Record-varying-phrase {cons("Record-varying-phrase")}

      "RECORDING" "MODE"? "IS"? Cobword -> Recording-mode-clause {cons("Recording-mode-clause")}

      Records Are? -> Records-are {cons("Records-are")}

      "TO" Integer -> To-integer {cons("To-integer")}

      "VALUE" "OF" Value-of-clause-tail+ -> Value-of-clause {cons("Value-of-clause")}

      System-name "IS"? Alt-qualified-data-name-literal -> Value-of-clause-tail {cons("Value-of-clause-tail")}


module VSC-io-sec
  imports VSC-fd-entry VSC-expr
  exports
    sorts
      Alt-assignment-name-file-name
      Alt-assignment-name-literal
      Alt-indexed-relative-sequential
      Alt-sequential-random-dynamic
      Alternate-record-key-clause
      Areas
      Assign-clause
      Every-phrase
      Every-phrase-1
      Every-phrase-2
      Fce-access-mode
      Fce-organization
      Fce-phrase
      File-control-entry
      File-control-paragraph
      File-name-position
      File-status-clause
      I-o-control-paragraph
      I-o-sam
      I-o-sort-merge
      Input-output-section
      Organization-is
      Padding-character-clause
      Password-clause
      Position
      Qsam-or-sam-or-vsam-i-o-control-entries
      Qsam-or-sam-or-vsam-i-o-control-entries-1
      Qsam-or-sam-or-vsam-i-o-control-entries-2
      Qsam-or-sam-or-vsam-i-o-control-entries-3
      Qsam-or-sam-or-vsam-i-o-control-entries-4
      Record-delimiter-clause
      Record-delimiter-name
      Record-key-clause
      Record-sort
      Relative-key-clause
      Rerun-on
      Reserve-clause
      Same-area
      Select-clause
      Sort-merge-i-o-control-entries
      With-duplicates

    context-free syntax
      Assignment-name -> Alt-assignment-name-file-name {cons("Alt-assignment-name-file-name-c1")}
      File-name -> Alt-assignment-name-file-name {cons("Alt-assignment-name-file-name-c2")}

      Assignment-name -> Alt-assignment-name-literal {cons("Alt-assignment-name-literal-c1")}
      Literal -> Alt-assignment-name-literal {cons("Alt-assignment-name-literal-c2")}

      "INDEXED" -> Alt-indexed-relative-sequential {cons("Alt-indexed-relative-sequential-c1")}
      "RELATIVE" -> Alt-indexed-relative-sequential {cons("Alt-indexed-relative-sequential-c2")}
      "SEQUENTIAL" -> Alt-indexed-relative-sequential {cons("Alt-indexed-relative-sequential-c3")}

      "SEQUENTIAL" -> Alt-sequential-random-dynamic {cons("Alt-sequential-random-dynamic-c1")}
      "RANDOM" -> Alt-sequential-random-dynamic {cons("Alt-sequential-random-dynamic-c2")}
      "DYNAMIC" -> Alt-sequential-random-dynamic {cons("Alt-sequential-random-dynamic-c3")}

      "ALTERNATE" "RECORD"? "KEY"? "IS"? Qualified-data-name Password-clause? With-duplicates? -> Alternate-record-key-clause {cons("Alternate-record-key-clause")}

      "AREA" -> Areas {cons("Areas-c1")}
      "AREAS" -> Areas {cons("Areas-c2")}

      "ASSIGN" "TO"? Alt-assignment-name-literal+ -> Assign-clause {cons("Assign-clause")}

      Every-phrase-1 -> Every-phrase {cons("Every-phrase-c1")}
      Every-phrase-2 -> Every-phrase {cons("Every-phrase-c2")}

      Integer "RECORDS" -> Every-phrase-1 {cons("Every-phrase-1")}

      "END" "OF"? Alt-reel-unit -> Every-phrase-2 {cons("Every-phrase-2")}

      "ACCESS" "MODE"? "IS"? Alt-sequential-random-dynamic Relative-key-clause? -> Fce-access-mode {cons("Fce-access-mode")}

      Organization-is? Alt-indexed-relative-sequential -> Fce-organization {cons("Fce-organization")}

      Reserve-clause -> Fce-phrase {cons("Fce-phrase-c1")}
      Fce-organization -> Fce-phrase {cons("Fce-phrase-c2")}
      Fce-access-mode -> Fce-phrase {cons("Fce-phrase-c3")}
      Record-key-clause -> Fce-phrase {cons("Fce-phrase-c4")}
      Password-clause -> Fce-phrase {cons("Fce-phrase-c5")}
      Alternate-record-key-clause -> Fce-phrase {cons("Fce-phrase-c6")}
      File-status-clause -> Fce-phrase {cons("Fce-phrase-c7")}
      Padding-character-clause -> Fce-phrase {cons("Fce-phrase-c8")}
      Record-delimiter-clause -> Fce-phrase {cons("Fce-phrase-c9")}

      Select-clause Assign-clause Fce-phrase* "." -> File-control-entry {cons("File-control-entry")}

      "FILE-CONTROL" "." File-control-entry* -> File-control-paragraph {cons("File-control-paragraph")}

      File-name Position? -> File-name-position {cons("File-name-position")}

      "FILE"? "STATUS" "IS"? Qualified-data-name Qualified-data-name? -> File-status-clause {cons("File-status-clause")}

      "I-O-CONTROL" "." I-o-sam? I-o-sort-merge? -> I-o-control-paragraph {cons("I-o-control-paragraph")}

      Qsam-or-sam-or-vsam-i-o-control-entries+ "." -> I-o-sam {cons("I-o-sam")}

      Sort-merge-i-o-control-entries "." -> I-o-sort-merge {cons("I-o-sort-merge")}

      "INPUT-OUTPUT" "SECTION" "." File-control-paragraph? I-o-control-paragraph? -> Input-output-section {cons("Input-output-section")}

      "ORGANIZATION" "IS"? -> Organization-is {cons("Organization-is")}

      "PADDING" "CHARACTER"? "IS"? Alt-qualified-data-name-literal -> Padding-character-clause {cons("Padding-character-clause")}

      "PASSWORD" "IS"? Data-name -> Password-clause {cons("Password-clause")}

      "POSITION" Integer -> Position {cons("Position")}

      Qsam-or-sam-or-vsam-i-o-control-entries-1 -> Qsam-or-sam-or-vsam-i-o-control-entries {cons("Qsam-or-sam-or-vsam-i-o-control-entries-c1")}
      Qsam-or-sam-or-vsam-i-o-control-entries-2 -> Qsam-or-sam-or-vsam-i-o-control-entries {cons("Qsam-or-sam-or-vsam-i-o-control-entries-c2")}
      Qsam-or-sam-or-vsam-i-o-control-entries-3 -> Qsam-or-sam-or-vsam-i-o-control-entries {cons("Qsam-or-sam-or-vsam-i-o-control-entries-c3")}
      Qsam-or-sam-or-vsam-i-o-control-entries-4 -> Qsam-or-sam-or-vsam-i-o-control-entries {cons("Qsam-or-sam-or-vsam-i-o-control-entries-c4")}

      "RERUN" "ON" Alt-assignment-name-file-name "EVERY"? Every-phrase "OF"? File-name -> Qsam-or-sam-or-vsam-i-o-control-entries-1 {cons("Qsam-or-sam-or-vsam-i-o-control-entries-1")}

      "SAME" "RECORD"? "AREA"? "FOR"? File-name File-name+ -> Qsam-or-sam-or-vsam-i-o-control-entries-2 {cons("Qsam-or-sam-or-vsam-i-o-control-entries-2")}

      "MULTIPLE" "FILE" "TAPE"? "CONTAINS"? File-name-position+ -> Qsam-or-sam-or-vsam-i-o-control-entries-3 {cons("Qsam-or-sam-or-vsam-i-o-control-entries-3")}

      "APPLY" "WRITE-ONLY" "ON"? File-name+ -> Qsam-or-sam-or-vsam-i-o-control-entries-4 {cons("Qsam-or-sam-or-vsam-i-o-control-entries-4")}

      "RECORD" "DELIMITER" "IS"? Record-delimiter-name -> Record-delimiter-clause {cons("Record-delimiter-clause")}

      "STANDARD-1" -> Record-delimiter-name {cons("Record-delimiter-name-c1")}
      Assignment-name -> Record-delimiter-name {cons("Record-delimiter-name-c2")}

      "RECORD" "KEY"? "IS"? Qualified-data-name -> Record-key-clause {cons("Record-key-clause")}

      "RECORD" -> Record-sort {cons("Record-sort-c1")}
      "SORT" -> Record-sort {cons("Record-sort-c2")}
      "SORT-MERGE" -> Record-sort {cons("Record-sort-c3")}

      "RELATIVE" "KEY"? "IS"? Qualified-data-name -> Relative-key-clause {cons("Relative-key-clause")}

      "RERUN" "ON" Assignment-name -> Rerun-on {cons("Rerun-on")}

      "RESERVE" Integer Areas? -> Reserve-clause {cons("Reserve-clause")}

      "SAME" Record-sort "AREA"? "FOR"? File-name File-name+ -> Same-area {cons("Same-area")}

      "SELECT" "OPTIONAL"? File-name -> Select-clause {cons("Select-clause")}

      Rerun-on? Same-area+ -> Sort-merge-i-o-control-entries {cons("Sort-merge-i-o-control-entries")}

      "WITH"? "DUPLICATES" -> With-duplicates {cons("With-duplicates")}


module VSC-id-div
