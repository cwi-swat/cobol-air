      Common-initial-1
      Common-initial-2
      Common-initial-program
      Nested-cobol-source-program
      Nested-program
      Program-id-nested-cobol-source-program
      Programs

    context-free syntax
      Identification-division Environment-division? Data-division? Procedure-division? Nested-program? -> Cobol-source-program {cons("Cobol-source-program")}

      Common-initial-1 -> Common-initial {cons("Common-initial-c1")}
      Common-initial-2 -> Common-initial {cons("Common-initial-c2")}

      "COMMON" "INITIAL"? -> Common-initial-1 {cons("Common-initial-1")}

      "INITIAL" "COMMON"? -> Common-initial-2 {cons("Common-initial-2")}

      "IS"? Common-initial "PROGRAM"? -> Common-initial-program {cons("Common-initial-program")}

      Identification "DIVISION" "." Program-id-nested-cobol-source-program Identification-division-content? Environment-division? Data-division? Procedure-division? Nested-cobol-source-program* "END" "PROGRAM" Program-name "." -> Nested-cobol-source-program {cons("Nested-cobol-source-program")}

      Nested-cobol-source-program* "END" "PROGRAM" Program-name "." -> Nested-program {cons("Nested-program")}

      "PROGRAM-ID" "."? Program-name Common-initial-program? "."? -> Program-id-nested-cobol-source-program {cons("Program-id-nested-cobol-source-program")}

