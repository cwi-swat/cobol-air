module VSC-proc-div
  imports VSC-stat VSC-expr
  exports
    sorts
      Altered-goto
      Declaratives
      Declaratives-content
      Paragraph
      Paragraph-1
      Paragraphs
      Procedure-division
      Section-header
      Section-with-header
      Sections
      Sentence
      Sentence-1
      Sentence-2
      Using-data-names
      Using-phrase
      Using-phrase-1
      Using-phrase-2

    context-free syntax
      Paragraph-name "." "GO" "TO"? "." -> Altered-goto {cons("Altered-goto")}

      "DECLARATIVES" "." Declaratives-content+ "END" "DECLARATIVES" "." -> Declaratives {cons("Declaratives")}

      Section-header "." Use-statement "." Paragraphs -> Declaratives-content {cons("Declaratives-content")}

      Altered-goto -> Paragraph {cons("Paragraph-c1")}
      Paragraph-1 -> Paragraph {cons("Paragraph-c2")}

      Paragraph-name "." Sentence* -> Paragraph-1 {cons("Paragraph-1")}

      Sentence* Paragraph* -> Paragraphs {cons("Paragraphs")}

      "PROCEDURE" "DIVISION" Using-phrase Declaratives? Sections -> Procedure-division {cons("Procedure-division")}

      Section-name "SECTION" Priority-number? -> Section-header {cons("Section-header")}

      Section-header "." Paragraphs -> Section-with-header {cons("Section-with-header")}

      Paragraphs Section-with-header* -> Sections {cons("Sections")}

      Sentence-1 -> Sentence {cons("Sentence-c1")}
      Sentence-2 -> Sentence {cons("Sentence-c2")}

      Statement-list "."+ -> Sentence-1 {cons("Sentence-1")}

      Statement-list? Copy-statement -> Sentence-2 {cons("Sentence-2")}

      "USING" Data-name* -> Using-data-names {cons("Using-data-names")}

      Using-phrase-1 -> Using-phrase {cons("Using-phrase-c1")}
      Using-phrase-2 -> Using-phrase {cons("Using-phrase-c2")}

      Using-data-name-pluslist? "." -> Using-phrase-1 {cons("Using-phrase-1")}

      Using-data-names? Copy-statement -> Using-phrase-2 {cons("Using-phrase-2")}


module VSC-lex
imports VSC-layout KEYWORDS
exports
  sorts
    Picture-string
    Quoted-pseudo-text
    Nonnumeric
    Id
    Num
  context-free syntax
    Id -> Cobword
  lexical syntax
    (~[\ \t\n\,\;\.] | ([\,\;\.] ~[\ \t\n]))+ -> Picture-string
    "==" ~[\=]* "==" -> Quoted-pseudo-text
    [\"] ~[\"]* [\"] -> Nonnumeric
    [\'] ~[\']* [\'] -> Nonnumeric
    [0-9\-]* [A-Za-z] [A-Za-z0-9\-]* -> Id
    [0-9]+([\-][0-9]+)+ -> Id
    [\+\-]? (([0-9]* [\.\,] [0-9]+) | [0-9]+) -> Num
  lexical restrictions
    Id  -/- [A-Za-z0-9\-]
    Num -/- [0-9]
    Picture-string -/- ~[\ \t\n\,\;\.]




module VSC-layout
exports
  lexical syntax
    "%" ~[\n]* [\n] -> LAYOUT
    [\ \t\n] -> LAYOUT
    ", " -> LAYOUT
    ",\n" -> LAYOUT
  context-free restrictions
    LAYOUT? -/- [\,\ \t\n\%]



module VSC-cond
  imports VSC-expr
  exports
    sorts
      Alt-and-or
      And-or-combinable-condition
      Class-condition
      Class-type
      Combinable-condition
      Combined-conditions
      Condition
      Condition-name-reference
      Greater
      Greater-equal
      Greater-than
      Greater-than-1
      Greater-than-or-equal-to
      Greater-than-or-equal-to-1
      Greater-than-or-equal-to-2
      Greater-than-or-equal-to-3
      Is-not
      Is-or-is-not
      Less
      Less-equal
      Less-equal-2
      Negated-simple-conditions
      Not-is
      Not-relational-operator-rest
      Relation-condition
      Relational-operator
      Relational-operator-rest
      Relational-operator-tail
      Sign-condition
      Sign-type
      Simple-condition
      Simple-condition-1
      Than

    context-free syntax
      "AND" -> Alt-and-or {cons("Alt-and-or-c1")}
      "OR" -> Alt-and-or {cons("Alt-and-or-c2")}

      Alt-and-or Relational-operator? Combinable-condition -> And-or-combinable-condition {cons("And-or-combinable-condition")}

      Identifier Is-or-is-not Class-type -> Class-condition {cons("Class-condition")}

      "NUMERIC" -> Class-type {cons("Class-type-c1")}
      "ALPHABETIC" -> Class-type {cons("Class-type-c2")}
      "ALPHABETIC-LOWER" -> Class-type {cons("Class-type-c3")}
      "ALPHABETIC-UPPER" -> Class-type {cons("Class-type-c4")}
      Class-name -> Class-type {cons("Class-type-c5")}
      "DBCS" -> Class-type {cons("Class-type-c6")}
      "KANJI" -> Class-type {cons("Class-type-c7")}

      Simple-condition -> Combinable-condition {cons("Combinable-condition-c1")}
      Negated-simple-conditions -> Combinable-condition {cons("Combinable-condition-c2")}

      Combinable-condition And-or-combinable-condition+ -> Combined-conditions {cons("Combined-conditions")}

      Combined-conditions -> Condition {cons("Condition-c1")}
      Combinable-condition -> Condition {cons("Condition-c2")}

      Condition-name In-data-or-file-or-mnemonic-name* Subscript-parentheses* -> Condition-name-reference {cons("Condition-name-reference")}

      "GREATER" Than -> Greater {cons("Greater")}

      "GREATER" Than "OR" "EQUAL" "TO"? -> Greater-equal {cons("Greater-equal")}

      Greater-than-1 -> Greater-than {cons("Greater-than-c1")}
      ">" -> Greater-than {cons("Greater-than-c2")}

      "GREATER" "THAN"? -> Greater-than-1 {cons("Greater-than-1")}

      Greater-than-or-equal-to-1 -> Greater-than-or-equal-to {cons("Greater-than-or-equal-to-c1")}
      Greater-than-or-equal-to-2 -> Greater-than-or-equal-to {cons("Greater-than-or-equal-to-c2")}
      Greater-than-or-equal-to-3 -> Greater-than-or-equal-to {cons("Greater-than-or-equal-to-c3")}
      ">=" -> Greater-than-or-equal-to {cons("Greater-than-or-equal-to-c4")}

      "GREATER" "THAN"? "OR" "EQUAL" "TO"? -> Greater-than-or-equal-to-1 {cons("Greater-than-or-equal-to-1")}

      "NOT" "LESS" "THAN"? -> Greater-than-or-equal-to-2 {cons("Greater-than-or-equal-to-2")}

      "NOT" "<" -> Greater-than-or-equal-to-3 {cons("Greater-than-or-equal-to-3")}

      "IS"? "NOT"? -> Is-not {cons("Is-not")}

      Not-is -> Is-or-is-not {cons("Is-or-is-not-c1")}
      Is-not -> Is-or-is-not {cons("Is-or-is-not-c2")}

      "LESS" Than -> Less {cons("Less")}

      "LESS" Than "OR" "EQUAL" "TO"? -> Less-equal {cons("Less-equal")}

      "<" "=" -> Less-equal-2 {cons("Less-equal-2")}

      "NOT" Combinable-condition -> Negated-simple-conditions {cons("Negated-simple-conditions")}

      "NOT" "IS" -> Not-is {cons("Not-is")}

      "NOT"? Relational-operator-rest -> Not-relational-operator-rest {cons("Not-relational-operator-rest")}

      Arithmetic-expression Relational-operator Simple-condition -> Relation-condition {cons("Relation-condition")}

      "IS"? Relational-operator-tail -> Relational-operator {cons("Relational-operator")}

      Greater -> Relational-operator-rest {cons("Relational-operator-rest-c1")}
      ">" -> Relational-operator-rest {cons("Relational-operator-rest-c2")}
      Less -> Relational-operator-rest {cons("Relational-operator-rest-c3")}
      "<" -> Relational-operator-rest {cons("Relational-operator-rest-c4")}
      Equal-to -> Relational-operator-rest {cons("Relational-operator-rest-c5")}

      Greater-equal -> Relational-operator-tail {cons("Relational-operator-tail-c1")}
      Less-equal -> Relational-operator-tail {cons("Relational-operator-tail-c2")}
      Less-equal-2 -> Relational-operator-tail {cons("Relational-operator-tail-c3")}
      ">=" -> Relational-operator-tail {cons("Relational-operator-tail-c4")}
      Not-relational-operator-rest -> Relational-operator-tail {cons("Relational-operator-tail-c5")}

      Arithmetic-expression Is-or-is-not Sign-type -> Sign-condition {cons("Sign-condition")}

      "POSITIVE" -> Sign-type {cons("Sign-type-c1")}
      "NEGATIVE" -> Sign-type {cons("Sign-type-c2")}
      "ZERO" -> Sign-type {cons("Sign-type-c3")}
      "ZEROES" -> Sign-type {cons("Sign-type-c4")}
      "ZEROS" -> Sign-type {cons("Sign-type-c5")}

      Class-condition -> Simple-condition {cons("Simple-condition-c1")}
      Relation-condition -> Simple-condition {cons("Simple-condition-c2")}
      Sign-condition -> Simple-condition {cons("Simple-condition-c3")}
      Simple-condition-1 -> Simple-condition {cons("Simple-condition-c4")}
      Arithmetic-expression -> Simple-condition {cons("Simple-condition-c5")}

      "(" Condition ")" -> Simple-condition-1 {cons("Simple-condition-1")}

      "THAN" -> Than {cons("Than-c1")}
      "THEN"? -> Than {cons("Than-c2")}


