      Identification-division-phrase
      Initial-program
      Installation
      Program-id-cobol-source-program
      Remarks
      Security

    context-free syntax
      "AUTHOR" "."? -> Author {cons("Author")}

      "DATE-COMPILED" "."? -> Date-compiled {cons("Date-compiled")}

      "DATE-WRITTEN" "."? -> Date-written {cons("Date-written")}

      "IDENTIFICATION" -> Identification {cons("Identification-c1")}
      "ID" -> Identification {cons("Identification-c2")}

      Identification "DIVISION" "." Program-id-cobol-source-program Identification-division-content -> Identification-division {cons("Identification-division")}

      Identification-division-phrase* -> Identification-division-content {cons("Identification-division-content")}

      Author -> Identification-division-phrase {cons("Identification-division-phrase-c1")}
      Installation -> Identification-division-phrase {cons("Identification-division-phrase-c2")}
      Date-written -> Identification-division-phrase {cons("Identification-division-phrase-c3")}
      Date-compiled -> Identification-division-phrase {cons("Identification-division-phrase-c4")}
      Security -> Identification-division-phrase {cons("Identification-division-phrase-c5")}
      Remarks -> Identification-division-phrase {cons("Identification-division-phrase-c6")}

      "IS"? "INITIAL" "PROGRAM"? -> Initial-program {cons("Initial-program")}

      "INSTALLATION" "."? -> Installation {cons("Installation")}

      "PROGRAM-ID" "."? Program-name Initial-program? "."? -> Program-id-cobol-source-program {cons("Program-id-cobol-source-program")}

      "REMARKS" "."? -> Remarks {cons("Remarks")}

      "SECURITY" "."? -> Security {cons("Security")}


