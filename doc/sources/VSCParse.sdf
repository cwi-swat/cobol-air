      Alt-plus-minus Times-div -> Arithmetic-expression-tail {cons("Arithmetic-expression-tail")}

      System-name -> Assignment-name {cons("Assignment-name")}

      Literal -> Basis {cons("Basis-c1")}
      Identifier -> Basis {cons("Basis-c2")}
      Basis-1 -> Basis {cons("Basis-c3")}

      "(" Arithmetic-expression ")" -> Basis-1 {cons("Basis-1")}

      Alphabetic-user-defined-word -> Class-name {cons("Class-name")}

      System-name -> Computer-name {cons("Computer-name")}

      Alphabetic-user-defined-word -> Condition-name {cons("Condition-name")}

      Quoted-pseudo-text -> Copy-operand {cons("Copy-operand-c1")}
      Identifier -> Copy-operand {cons("Copy-operand-c2")}
      Literal -> Copy-operand {cons("Copy-operand-c3")}

