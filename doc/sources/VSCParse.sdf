      "QUOTE" -> Figurative-constant-simple {cons("Figurative-constant-simple-c10")}
      "QUOTES" -> Figurative-constant-simple {cons("Figurative-constant-simple-c11")}
      "NULL" -> Figurative-constant-simple {cons("Figurative-constant-simple-c12")}
      "NULLS" -> Figurative-constant-simple {cons("Figurative-constant-simple-c13")}

      Alphabetic-user-defined-word -> File-name {cons("File-name")}

      Identifier-1 -> Identifier {cons("Identifier-c1")}
      Identifier-2 -> Identifier {cons("Identifier-c2")}

      Qualified-data-name Subscript-parentheses* Reference-modification? -> Identifier-1 {cons("Identifier-1")}

      "LINAGE-COUNTER" In-file-name? -> Identifier-2 {cons("Identifier-2")}

      "OF" -> In {cons("In-c1")}
      "IN" -> In {cons("In-c2")}

      In Data-or-file-name -> In-data-or-file-name {cons("In-data-or-file-name")}

      In Data-or-file-or-mnemonic-name -> In-data-or-file-or-mnemonic-name {cons("In-data-or-file-or-mnemonic-name")}

      In File-name -> In-file-name {cons("In-file-name")}

      In Alt-library-name-literal -> In-library {cons("In-library")}

      In Section-name -> In-section-name {cons("In-section-name")}

      Alphabetic-user-defined-word -> Index-name {cons("Index-name")}

